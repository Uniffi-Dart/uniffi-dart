[Error]
enum ChronologicalError {
  "TimeOverflow",
  "TimeDiffError",
};

namespace time_types {
  [Throws=ChronologicalError]
  timestamp return_timestamp(timestamp a);

  [Throws=ChronologicalError]
  duration return_duration(duration a);

  string to_string_timestamp(timestamp a);

  timestamp get_pre_epoch_timestamp();

  [Throws=ChronologicalError]
  timestamp add(timestamp a, duration b);

  [Throws=ChronologicalError]
  duration diff(timestamp a, timestamp b);

  timestamp now();

  timestamp timestamp_from_parts(i64 seconds, u32 nanos);
  u32 timestamp_nanos(timestamp value);
  TimeBundle echo_time_bundle(TimeBundle value);
  timestamp callback_timestamp(TimeSource source, timestamp value);
  [Async]
  timestamp return_timestamp_async(timestamp value);

  boolean equal(timestamp a, timestamp b);

  boolean optional(timestamp? a, duration? b);

  [Throws=ChronologicalError]
  u64 get_seconds_before_unix_epoch(timestamp a);

  [Throws=ChronologicalError]
  timestamp set_seconds_before_unix_epoch(u64 seconds);
};

dictionary TimeBundle {
  timestamp at;
  timestamp? optional_at;
  sequence<timestamp> history;
  record<string, timestamp> named;
};

callback interface TimeSource {
  timestamp echo(timestamp value);
};

interface TimeKeeper {
  constructor(timestamp value);
  timestamp get();
  timestamp echo(timestamp value);
};
